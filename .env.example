# ─── TTT Builder — Bring Your Own LLM Keys ───────────────────────────
# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored — your keys never get pushed to GitHub.
#
# Keys set here are baked into the build (Vite import.meta.env) and appear
# as read-only "🔒" entries in the model picker. They work in both local dev
# and production builds.
#
# For browser-only keys (not in the build), use the in-app Settings →
# "Open Models" tab instead — those live in localStorage per-browser.

# DeepSeek (https://platform.deepseek.com/api_keys)
VITE_DEEPSEEK_API_KEY=

# Google Gemini AI Studio (https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=

# xAI Grok (https://console.x.ai) — browser calls go through /api/llm
VITE_XAI_API_KEY=
VITE_XAI_MODEL=grok-4

# Groq (https://console.groq.com/keys) — CORS-friendly, free tier
VITE_GROQ_API_KEY=

# OpenRouter (https://openrouter.ai/keys) — CORS-friendly, 300+ models
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# Optional: server-side fallback used only by /api/llm if the request body has no key
# XAI_API_KEY=
# LLM_API_KEY=

# Generic OpenAI-compatible provider (any endpoint)
VITE_LLM_API_KEY=
VITE_LLM_BASE_URL=
VITE_LLM_MODEL=
VITE_LLM_PROVIDER=
VITE_LLM_LABEL=
